# Customer Churn Prediction Platform - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection URL (REQUIRED in production)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql+psycopg2://churn_user:secure_password@db:5432/churn_db
DATABASE_URL=

# =============================================================================
# Security Configuration
# =============================================================================
# API Key for authentication (REQUIRED in production)
# Generate a secure random string (min 32 chars recommended)
# Example: openssl rand -base64 32
API_KEY=

# HTTP header name for API key authentication
API_KEY_HEADER=X-API-Key

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_BATCH=10/minute
RATE_LIMIT_BATCH_MAX_SIZE=100

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
# Use specific origins in production, not "*"
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Environment
# =============================================================================
# Set to: development, staging, or production
ENVIRONMENT=development

# =============================================================================
# Data Retention Configuration
# =============================================================================
# Retention period for prediction records in days (default: 90)
# Records older than this will be deleted by the cleanup job
DATA_RETENTION_DAYS=90

# Batch size for retention cleanup job (default: 1000)
DATA_RETENTION_BATCH_SIZE=1000

# Dry run mode - if true, cleanup job only logs what would be deleted (default: false)
DATA_RETENTION_DRY_RUN=false

# =============================================================================
# Data Minimization Configuration
# =============================================================================
# Enable data minimization - store only necessary fields in raw_features (default: true)
DATA_MINIMIZATION_ENABLED=true