FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# We copy pyproject.toml and use pip
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# Copy application code
COPY src/ /app/src/
COPY alembic.ini /app/alembic.ini
COPY alembic/ /app/alembic/

# Create models directory (the folder is gitignored, may not exist in clean checkout)
# In production, artifact is loaded from S3 via MODEL_ARTIFACTS_BUCKET/KEY
# In CI, test artifact is generated before Docker build
RUN mkdir -p /app/models
COPY models/ /app/models/

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Create a non-root user and switch to it
RUN useradd -m apiuser && chown -R apiuser:apiuser /app
USER apiuser

# Expose port
EXPOSE 8000

# Entrypoint runs migrations then starts the application
ENTRYPOINT ["/docker-entrypoint.sh"]

# Default command starts the Uvicorn server
# Settings are loaded from environment variables via src.config.Settings
CMD ["uvicorn", "src.api:app", "--host", "${API_HOST:-0.0.0.0}", "--port", "${API_PORT:-8000}", "--workers", "${API_WORKERS:-2}", "--keep-alive-timeout", "${UVICORN_KEEP_ALIVE_TIMEOUT:-75}", "--timeout-keep-alive", "${UVICORN_KEEP_ALIVE_TIMEOUT:-75}", "--limit-concurrency", "${UVICORN_LIMIT_CONCURRENCY:-1000}", "--backlog", "${UVICORN_BACKLOG:-2048}", "--log-level", "${LOG_LEVEL:-info}", "--access-log", "--proxy-headers", "--forwarded-allow-ips=*"]